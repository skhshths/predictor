// Cloudflare Workers config: serves the static site in ./public (no build step).
// "name" must match the Worker you connected in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misty-hill-53e8",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
